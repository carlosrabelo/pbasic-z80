10 REM PBasic Arithmetic Demonstration
20 LET A = 1000
30 LET B = 250
40 PRINT "A = "; A; ", B = "; B
50 PRINT "A + B = "; A + B
60 PRINT "A - B = "; A - B
70 LET M = 12 * 8
80 PRINT "12 * 8 = "; M
90 LET D = 100 / 7
100 PRINT "100 / 7 = "; D
110 LET N = 100 - (D * 7)
120 PRINT "100 % 7 = "; N
130 LET U = 50000
140 LET V = 50000
150 LET X = U + V
160 PRINT "32-BIT SUM (50000 + 50000): "; X
170 END
RUN
